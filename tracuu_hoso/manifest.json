   } ],
   "description": "Hỗ trợ tải hàng loạt hồ sơ thuế đã nộp trên DVC và đã nộp trên Thuế điện tử trong 1 năm chỉ với 1 click. Không thu thập dữ liệu.",
   "host_permissions": [ "https://dichvucong.gdt.gov.vn/*" ],
