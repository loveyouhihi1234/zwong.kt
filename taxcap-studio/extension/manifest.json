{
  "manifest_version": 3,
  "name": "TaxCap — Tự điền Captcha Thuế & DVC",
  "version": "1.1.0",
  "description": "Tự động đọc và điền sẵn mã captcha cho 4 cổng Thuế và Dịch vụ công. Chạy độc lập với Gemini API Key của bạn hoặc qua Proxy.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://hoadondientu.gdt.gov.vn/*",
    "https://thuedientu.gdt.gov.vn/*",
    "https://dichvucong.gdt.gov.vn/*",
    "https://tracuunnt.gdt.gov.vn/*",
    "https://generativelanguage.googleapis.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "icons": {
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "TaxCap — Tự điền Captcha",
    "default_popup": "popup.html",
    "default_icon": {
      "48": "icons/icon-48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://hoadondientu.gdt.gov.vn/*"],
      "js": [
        "content/captcha-svg-templates.js",
        "content/captcha-svg.js",
        "content/common.js",
        "content/hddt.js"
      ],
      "run_at": "document_end"
    },
    {
      "matches": ["https://thuedientu.gdt.gov.vn/*"],
      "js": ["content/common.js", "content/tdt.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://dichvucong.gdt.gov.vn/*"],
      "js": ["content/common.js", "content/dvc.js"],
      "run_at": "document_end"
    },
    {
      "matches": ["https://tracuunnt.gdt.gov.vn/*"],
      "js": ["content/common.js", "content/tracuunnt.js"],
      "run_at": "document_end"
    }
  ]
}
