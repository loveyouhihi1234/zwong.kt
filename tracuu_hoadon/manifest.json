{
   "action": {
      "default_icon": {
         "128": "icons/icon-128.png",
         "16": "icons/icon-16.png",
         "32": "icons/icon-32.png",
         "48": "icons/icon-48.png"
      },
      "default_title": "Tải hóa đơn điện tử hàng loạt"
   },
   "background": {
      "service_worker": "src/background/service-worker.js",
      "type": "module"
   },
   "content_scripts": [
      {
         "js": [
            "src/content/zip.js",
            "src/content/xlsx.js",
            "src/content/captcha-svg-templates.js",
            "src/content/captcha-svg.js",
            "src/content/hddt-api.js",
            "src/content/report.js",
            "src/content/pdf.js",
            "src/content/content.js"
         ],
         "matches": [
            "https://hoadondientu.gdt.gov.vn/*"
         ],
         "run_at": "document_idle"
      }
   ],
   "description": "Tải hàng loạt hóa đơn mua vào, bán ra (XML, PDF, Excel) cả năm chỉ 1 click. Không cần mật khẩu, không gửi dữ liệu hóa đơn ra ngoài.",
   "host_permissions": [
      "https://hoadondientu.gdt.gov.vn/*"
   ],
   "icons": {
      "128": "icons/icon-128.png",
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
   },
   "key": "",
   "manifest_version": 3,
   "name": "Tải hóa đơn điện tử hàng loạt",
   "permissions": [
      "sidePanel",
      "downloads",
      "storage"
   ],
   "short_name": "Tải hóa đơn hàng loạt",
   "side_panel": {
      "default_path": "src/sidepanel/index.html"
   },
   "version": "1.0.0",
   "web_accessible_resources": [
      {
         "matches": [
            "https://hoadondientu.gdt.gov.vn/*"
         ],
         "resources": [
            "src/content/fonts/*.ttf"
         ]
      }
   ]
}